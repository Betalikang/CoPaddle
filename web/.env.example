# 复制为 .env 后填写真实值。注意必须是 .env，不是 .env.local（代码只读 .env）。
POSTGRES_URL=postgresql://***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# 下面两个 Stripe 变量是脚手架遗留，当前 CoPaddle 没有任何计费/订阅代码在用它
# （只有 lib/db/schema.ts 的 users 表保留了三个 stripe_* 列），可以留空。
# 真正的初始化请用 `pnpm db:migrate`；`pnpm db:setup` 会拦住你输 Stripe 密钥，
# 那是脚手架原始流程，不要用它初始化 CoPaddle 的库。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 演示模式。只有设为 true 时登录页才渲染「演示账号」一键填充区块，
# 且口令来自下面的 DEMO_PASSWORD（非 NEXT_PUBLIC_，不进客户端 bundle）。
# 正式环境必须留空或设为 false。
DEMO_MODE=false
DEMO_PASSWORD=

# 会话 Cookie 的 Secure 开关。留空时按 BASE_URL 协议推断（https→Secure）。
# 只在「反代终结 TLS、容器内看到的是 http」这类场景里显式写 false 兜底。
# COOKIE_SECURE=