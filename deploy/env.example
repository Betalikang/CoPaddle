# 复制为 .env 并改掉密钥；不要提交 .env
POSTGRES_USER=gongjiang
POSTGRES_PASSWORD=change-me-strong-db-pass
POSTGRES_DB=gongjiang

AUTH_SECRET=change-me-32bytes-random
ALGO_SHARED_SECRET=change-me-internal-secret

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 对外站点地址，Caddyfile 读它决定是否启用 HTTPS：
#   有域名 → 写域名（如 copaddle.example.edu.cn），Caddy 自动签 Let's Encrypt 证书并
#            把 HTTP 301 到 HTTPS；
#   没域名 → 留 :80，仅 HTTP（明文，仅限内网/临时演示）。
SITE_ADDRESS=:80

# BASE_URL 必须和 SITE_ADDRESS 的协议一致：它决定会话 cookie 是否带 Secure，
# 不一致会出现「登录成功、刷新即被踢回登录页」。
#   SITE_ADDRESS 是域名 → https://copaddle.example.edu.cn
#   SITE_ADDRESS=:80    → http://47.97.96.242
BASE_URL=http://47.97.96.242

# 演示模式：仅演示环境设为 true。
# 开启后登录页会显示三张演示账号卡并一键填入 DEMO_PASSWORD（口令来自本文件）。
# 正式环境必须留空或不设 —— 登录页不渲染演示区块，口令字符串也不会进客户端包。
DEMO_MODE=
DEMO_PASSWORD=
