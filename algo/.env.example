# 共桨算法服务环境变量模板（复制为 .env 后填写；.env 不入库）
# 约定见《技术选型说明书》T8

# 数据库（与 web 共享同一 PostgreSQL；algo 只读画像、只写结果表）
DATABASE_URL=postgresql://gongjiang:gongjiang@localhost:5433/gongjiang

# 服务间共享密钥（必须与 web 侧 ALGO_SHARED_SECRET 一致）
ALGO_SHARED_SECRET=change-me-to-a-random-string

# LLM（DeepSeek，OpenAI 兼容协议）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2

# 本地对象存储目录
STORAGE_DIR=./storage/uploads
